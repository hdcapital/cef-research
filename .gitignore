# Raw downloaded data is cached, not committed (size / licensing).
# The pipeline recreates it from public sources.
data/raw/
data/cache/
data/investegate_cache/

# Local processed artifacts can be large; parquet outputs are rebuilt by CI.
# (Small derived CSVs under outputs/ ARE committed for auditability.)
data/processed/*.parquet

# The UK daily NAV/price/discount panels. Working state, not the repo's job:
# a daily job rewriting a 25MB parquet would add ~9GB of git history a year.
# S3 holds them (sync_state.py group `uk_daily`), the committed
# data/uk_nav_history*.parquet shards seed a bucket-less rebuild, and the
# small per-fund deliverables under outputs/live/ ARE committed.
data/uk/

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# intermediate build file for the PDF edition (regenerated by scripts/make_pdf_report.py)
outputs/pdf/report_print.html
data/asx_ann_cache/
