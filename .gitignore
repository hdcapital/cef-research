# Raw downloaded data is cached, not committed (size / licensing).
# The pipeline recreates it from public sources.
data/raw/
data/cache/
data/investegate_cache/

# Local processed artifacts can be large; parquet outputs are rebuilt by CI.
# (Small derived CSVs under outputs/ ARE committed for auditability.)
data/processed/*.parquet

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
